{
  "name": "atl-arcade",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ATL Arcade — Atlanta games on real open data. Skate ATL first.",
  "scripts": {
    "dev": "vite",
    "validate:landmarks": "node scripts/validate-landmarks.mjs",
    "prebuild": "npm run validate:landmarks",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "playtest": "node scripts/playtest.mjs",
    "playtest:beltline": "node scripts/playtest.mjs --level beltline-eastside",
    "loadcheck": "node scripts/load-check.mjs",
    "perf": "node scripts/perf.mjs --out reports/perf/perf.json",
    "perf:baseline": "node scripts/perf.mjs --repeat 2 --out docs/perf/baseline.json --md docs/perf/baseline.md",
    "perf:check": "node scripts/perf.mjs --out reports/perf/perf.json --budget docs/perf/budget.json",
    "perf:sim": "node scripts/sim-bench.mjs",
    "npc:variety": "node scripts/npc-variety.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "polygon-clipping": "0.15.7",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "earcut": "3.2.4",
    "three": "0.186.1"
  },
  "engines": {
    "node": "24.x"
  }
}
