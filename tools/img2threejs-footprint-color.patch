+# Local patch (atl-arcade, 2026-11-02): per-part color on the visible footprint.
+# The cluster check above compares every part against at most 5 k-means groups
+# of the whole render, so a small part never forms a group and always fails.
+# grimoire/review/divine_eye_microscope.md asks for the visible footprint
+# instead: the pixels that change when one part is hidden. With
+# --footprint-dir, the directory holds full.png (an unlit, map-stripped
+# render) and hide-<componentId>.png (the same render with that part hidden).
+FOOTPRINT_PIXEL_DELTA = 24  # max channel difference that counts as changed
+FOOTPRINT_MIN_PIXELS = 12  # under this, the part is reported unmeasured
+
+
+def footprint_color_delta(components: list[tuple[str, dict[str, Any]]], footprint_dir: Path, textured: set[str] | None = None) -> dict[str, Any]:
+    width, height, full, _w = load_image(footprint_dir / "full.png")
+    results = []
+    for component_id, recipe in components:
+        # A part with a canvas texture (for example a letter card) has two or
+        # more colors, so one recipe color cannot describe its footprint; the
+        # visual review judges it.
+        if textured and component_id in textured:
+            results.append({"componentId": component_id, "status": "textured-card"})
+            continue
+        dominant = recipe.get("dominantAlbedo")
+        hidden_path = footprint_dir / f"hide-{component_id}.png"
+        if not isinstance(dominant, str) or not hidden_path.exists():
+            results.append({"componentId": component_id, "status": "no-evidence"})
+            continue
+        hw, hh, hidden, _w2 = load_image(hidden_path)
+        if (hw, hh) != (width, height):
+            results.append({"componentId": component_id, "status": "size-mismatch"})
+            continue
+        total = [0, 0, 0]
+        count = 0
+        for (r, g, b, _a), (hr, hg, hb, _ha) in zip(full, hidden):
+            if max(abs(r - hr), abs(g - hg), abs(b - hb)) > FOOTPRINT_PIXEL_DELTA:
+                total[0] += r
+                total[1] += g
+                total[2] += b
+                count += 1
+        if count < FOOTPRINT_MIN_PIXELS:
+            results.append({"componentId": component_id, "status": "unmeasured-too-small", "footprintPixels": count})
+            continue
+        mean = tuple(int(round(v / count)) for v in total)
+        rgb_text = dominant[dominant.index("(") + 1 : dominant.index(")")]
+        er, eg, eb = (int(float(part.strip())) for part in rgb_text.split(",")[:3])
+        delta = lab_distance(srgb_to_lab((er, eg, eb)), srgb_to_lab(mean))
+        results.append({"componentId": component_id, "status": "measured", "footprintPixels": count, "meanRgb": list(mean), "deltaE": round(delta, 2)})
+    measured = [r["deltaE"] for r in results if r.get("status") == "measured"]
+    return {
+        "method": "visible-footprint",
+        "checked": len(measured),
+        "unmeasured": [r["componentId"] for r in results if r.get("status") != "measured"],
+        "maxDeltaE": round(max(measured), 2) if measured else 0.0,
+        "perComponent": results,
+    }
 
 
